# Postgres (used by docker-compose to initialize the database container)
POSTGRES_USER=facevalue
POSTGRES_PASSWORD=facevalue
POSTGRES_DB=facevalue

# Server
PORT=8080
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://facevalue:facevalue@postgres:5432/facevalue?sslmode=disable

# Auth (magic link + email allowlist, ported from massa)
COOKIE_SIGNING_SECRET=dev-placeholder-change-me
COOKIE_SECURE=false
ALLOWED_EMAILS=you@example.com
MAGIC_LINK_FROM_EMAIL=login@facevalue.local
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SES_REGION=

# Vision (Hugging Face Inference Providers router)
HF_TOKEN=
HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
HF_API_BASE=https://router.huggingface.co/v1

# Pricing source — "ebay_browse" (eBay Browse API, needs an approved eBay
# dev app) or "serpapi_ebay" (SerpApi's eBay engine, no eBay approval needed)
PRICE_SOURCE=serpapi_ebay
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_COMP_LIMIT=50

# eBay Browse API — only required when PRICE_SOURCE=ebay_browse
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_API_BASE=https://api.sandbox.ebay.com

# SerpApi — only required when PRICE_SOURCE=serpapi_ebay
SERPAPI_KEY=
SERPAPI_BASE=https://serpapi.com

# Images (S3 in production; MinIO locally)
S3_BUCKET=face-value-images-dev
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://minio:9000   # empty in production; set only for MinIO
S3_PUBLIC_ENDPOINT=http://localhost:9000   # empty in production; presigned URL host the browser can actually reach
S3_FORCE_PATH_STYLE=true        # false in production
S3_PRESIGN_TTL=15m
MAX_UPLOAD_BYTES=10485760

# Pipeline
MAX_CONCURRENT_APPRAISALS=4

# Frontend — separate API origin in local dev; production uses same-origin /api (docs/DEPLOY.md)
NUXT_PUBLIC_API_BASE=http://localhost:8080
